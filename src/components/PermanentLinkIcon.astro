---
import type { PermanentLinkKind } from '../types/content';

interface Props {
  kind: PermanentLinkKind;
}

const { kind } = Astro.props;
---

<svg
  class="link-icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {(kind === 'profileInstagram' || kind === 'instagram') && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <path d="M17.4 6.7h.01" />
    </>
  )}

  {kind === 'whatsapp' && (
    <>
      <path d="M20.4 11.6a8.4 8.4 0 0 1-12.3 7.5L3.5 20.5l1.4-4.4a8.4 8.4 0 1 1 15.5-4.5Z" />
      <path d="M8.5 7.8c.3-.3.7-.2.9.1l1 2c.1.3.1.6-.1.8l-.7.8c.8 1.7 1.9 2.8 3.7 3.6l.8-.9c.2-.2.5-.3.8-.1l2 1c.3.2.4.5.3.8-.4 1.2-1.4 1.8-2.7 1.7-3.9-.3-7.8-4.2-8.1-8.1-.1-.7.3-1.3 1.1-1.7Z" />
    </>
  )}

  {kind === 'tables' && (
    <>
      <path d="M5 10h14" />
      <path d="M7 10V7.5A2.5 2.5 0 0 1 9.5 5h5A2.5 2.5 0 0 1 17 7.5V10" />
      <path d="M8 10v9M16 10v9" />
      <path d="M4 15h4M16 15h4" />
    </>
  )}

  {kind === 'whatsappGroup' && (
    <>
      <circle cx="9" cy="9" r="3" />
      <circle cx="17" cy="10" r="2.25" />
      <path d="M3.5 19a5.5 5.5 0 0 1 11 0" />
      <path d="M14.5 15.3A4.5 4.5 0 0 1 21 19" />
    </>
  )}

  {kind === 'custom' && (
    <>
      <path d="M14 4h6v6" />
      <path d="m20 4-9 9" />
      <path d="M18 13v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5" />
    </>
  )}
</svg>

<style>
  .link-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 auto;
  }
</style>
