---
import type { ActiveSpecialLink } from '../types/content';

interface Props {
  link: ActiveSpecialLink;
}

const { link } = Astro.props;
---

<div
  class="special-link-card"
  data-special-link-card
>
  <a
    class="special-link-card__ticket-link"
    href={link.url}
    target="_blank"
    rel="noreferrer"
    aria-label={`${link.title}, ${link.venue}, productora ${link.producer}. Abrir tickets`}
  ></a>
  <div class="special-link-card__content">
    <h2 class="special-link-card__title">{link.title}</h2>
    {link.venueMapsUrl ? (
      <a
        class="special-link-card__venue special-link-card__venue--maps"
        href={link.venueMapsUrl}
        target="_blank"
        rel="noreferrer"
        aria-label={`Abrir ubicación de ${link.venue} en Google Maps`}
      >
        {link.venue}
      </a>
    ) : (
      <span class="special-link-card__venue">{link.venue}</span>
    )}
    <span class="special-link-card__producer">{link.producer}</span>
  </div>
  <span class="special-link-card__cta">Tickets</span>
</div>

<style>
  .special-link-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6.25rem;
    gap: 12px;
    align-items: start;
    min-height: 10rem;
    padding: 20px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
  }

  .special-link-card__ticket-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .special-link-card:hover,
  .special-link-card:has(:focus-visible) {
    border-color: var(--color-border-strong);
    background: linear-gradient(90deg, var(--color-accent-soft), transparent 46%);
  }

  .special-link-card__content {
    display: grid;
    min-width: 0;
    gap: 8px;
    justify-items: start;
    overflow-wrap: anywhere;
  }

  .special-link-card__title {
    margin: 0;
    font-size: clamp(1.55rem, 3.2vw, 3.1rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .special-link-card__venue {
    color: var(--color-text-muted);
  }

  .special-link-card__venue {
    font-size: 0.82rem;
    letter-spacing: 0.035em;
  }

  .special-link-card__venue--maps {
    position: relative;
    z-index: 2;
    min-width: 2.75rem;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding-inline: 0.5rem;
    margin-inline: -0.5rem;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 0.2em;
  }

  .special-link-card__venue--maps:hover,
  .special-link-card__venue--maps:focus-visible {
    color: var(--color-accent-bright);
  }

  .special-link-card__producer {
    margin-top: 8px;
    padding: 0.28rem 0.25rem 0.24rem;
    border: 1px solid var(--color-border);
    border-left-color: var(--color-accent);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
  }

  .special-link-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--color-accent);
    background: var(--color-accent);
    color: var(--color-background);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .special-link-card:hover .special-link-card__cta,
  .special-link-card:has(.special-link-card__ticket-link:focus-visible) .special-link-card__cta {
    background: var(--color-accent-bright);
    border-color: var(--color-accent-bright);
  }

  @media (max-width: 42rem) {
    .special-link-card {
      grid-template-columns: minmax(0, 1fr) 5.5rem;
      min-height: 8.5rem;
    }
  }

  @media (max-width: 22rem) {
    .special-link-card {
      grid-template-columns: minmax(0, 1fr) 5.25rem;
    }
  }
</style>
